{
	"name": "@repo/leonardo-contrast-colors",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"files": [
		"dist"
	],
	"source": "./lib/main.ts",
	"main": "./dist/main.js",
	"module": "./dist/main.js",
	"types": "./dist/main.d.ts",
	"exports": {
