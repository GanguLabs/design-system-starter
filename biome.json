{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
	"files": {
		"ignore": ["dist"]
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"useTemplate": "off",
				"useNumberNamespace": "off"
			},
			"complexity": {
				"noForEach": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 80,
		"formatWithErrors": true
	},
	"css": {
		"parser": {
			"cssModules": true
		}
	},
	"javascript": {
		"formatter": {
			"indentWidth": 2,
			"jsxQuoteStyle": "double",
			"quoteStyle": "single",
			"attributePosition": "multiline",
			"trailingCommas": "all"
		}
	},
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
	"overrides": [
		{
			"include": ["*.tsx", "*.jsx"],
			"javascript": {
				"formatter": {
					"trailingCommas": "es5"
				}
			}
		}
	]
}
